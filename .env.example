# ================================================================
# Brain Cache — Environment Variables Reference
# Copy frontend vars to frontend/.env.local
# Copy backend vars to .env
# ================================================================

# ────────────────────────────────────────────────────────────────
# FRONTEND  (frontend/.env.local)
# ────────────────────────────────────────────────────────────────

# Clerk — dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/api/workspace/bootstrap-redirect
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/api/workspace/bootstrap-redirect
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/api/workspace/bootstrap-redirect
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/api/workspace/bootstrap-redirect

# Database — required by Next.js API routes that use Prisma
DATABASE_URL=postgresql://braincache:changeme@localhost:5432/braincache

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe — dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...

# OAuth connector credential encryption — openssl rand -hex 32
CONNECTOR_ENCRYPTION_KEY=<64 hex chars>

# ────────────────────────────────────────────────────────────────
# BACKEND  (.env)
# ────────────────────────────────────────────────────────────────

POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://braincache:changeme@localhost:5432/braincache
REDIS_URL=redis://localhost:6379

# App URLs used by hosted connector callbacks
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Composio hosted OAuth connector setup
# Create auth configs in Composio, then map BrainCache connector ids to those auth config ids.
# Users still connect from the UI; these are admin-side hosted connector configs, not user tokens.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_IDS={"gmail":"","google_drive":"","google_calendar":"","slack":"","jira":"","github":"","notion":"","confluence":"","salesforce":"","hubspot":"","zendesk":"","microsoft_teams":"","onedrive":""}

# Gemini — aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
