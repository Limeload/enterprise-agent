# ============================================================
# Enterprise Knowledge & Action Agent — Environment Variables
# ============================================================

# ---------- LLM Providers ----------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
GROQ_API_KEY=...

# Primary model
LLM_MODEL=claude-sonnet-4-6

# ---------- Supabase ----------
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ---------- Observability ----------
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=enterprise-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=enterprise-agent

# ---------- Connectors — GitHub ----------
GITHUB_TOKEN=ghp_...
GITHUB_ORG=your-org

# ---------- Connectors — Notion ----------
NOTION_API_KEY=secret_...

# ---------- Connectors — Slack ----------
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# ---------- Connectors — HubSpot ----------
HUBSPOT_ACCESS_TOKEN=pat-...

# ---------- Connectors — Gmail / Google ----------
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...

# ---------- Connectors — Jira / Confluence ----------
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=...

# ---------- Connectors — Salesforce ----------
SALESFORCE_CLIENT_ID=...
SALESFORCE_CLIENT_SECRET=...
SALESFORCE_REFRESH_TOKEN=...
SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com

# ---------- Connectors — Zendesk ----------
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=you@example.com
ZENDESK_API_TOKEN=...

# ---------- Composio (connector framework) ----------
COMPOSIO_API_KEY=...

# ---------- App ----------
APP_ENV=development
API_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,https://your-domain.com
LOG_LEVEL=INFO
