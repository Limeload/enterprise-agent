# ================================================================
# Brain Cache — Environment Variables Reference
# Copy frontend vars to frontend/.env.local
# Copy backend vars to .env
# ================================================================

# ────────────────────────────────────────────────────────────────
# FRONTEND  (frontend/.env.local)
# ────────────────────────────────────────────────────────────────

# Clerk — dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/api/workspace/bootstrap-redirect
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/api/workspace/bootstrap-redirect

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe — dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...

# Connector token encryption — openssl rand -hex 32
CONNECTOR_ENCRYPTION_KEY=<64 hex chars>

# ────────────────────────────────────────────────────────────────
# BACKEND  (.env)
# ────────────────────────────────────────────────────────────────

POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://braincache:changeme@localhost:5432/braincache
REDIS_URL=redis://localhost:6379

# Gemini — aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
