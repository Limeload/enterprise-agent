# Copy to .env and fill in real values.

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
API_SECRET_KEY=change-me
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── LLM ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://braincache:changeme@localhost:5432/braincache
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Nango — OAuth connector infrastructure ────────────────────────────────────
# app.nango.dev → Project Settings → Secret Key
NANGO_SECRET_KEY=nango_sk_...

# ── Connectors ─────────────────────────────────────────────────────────────────
# Optional: restrict GitHub searches to a specific org
GITHUB_ORG=

# ── Observability ──────────────────────────────────────────────────────────────
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=enterprise-agent

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
