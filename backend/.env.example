# Copy to .env and fill in real values.

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
API_SECRET_KEY=change-me
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── LLM ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6
# Gemini is also supported.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://braincache:changeme@localhost:5432/braincache
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Connectors — OAuth via Composio ───────────────────────────────────────────
# app.composio.dev → API Keys — manages OAuth for all providers (no per-provider setup)
COMPOSIO_API_KEY=
# Optional: map connector names to pre-created Composio auth config IDs.
# Useful when COMPOSIO_API_KEY is scoped without Auth configs write access.
COMPOSIO_AUTH_CONFIG_IDS={}

# Optional: restrict GitHub searches to a specific org
GITHUB_ORG=

# ── Observability ──────────────────────────────────────────────────────────────
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=enterprise-agent

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
